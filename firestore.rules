rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is accessing their own customer record
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Check if user has an authorized admin record in Firestore or is a designated admin email
    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'gamechangerpos@gmail.com')
      );
    }

    // 1. Customer Profiles & Subcollections (Wishlist, Memories, Loyalty)
    match /customers/{userId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /wishlist/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /memories/{memoryId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /meta/{metaId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 2. Customer Travel Preferences
    match /customer_preferences/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 3. Support Conversations & Chat Threads
    match /conversations/{convId} {
      allow read, create, update: if isAuthenticated() || isAdmin();

      match /messages/{messageId} {
        allow read, create: if isAuthenticated() || isAdmin();
      }
    }

    // 4. Group Trips & Invitations
    match /group_trips/{tripId} {
      allow read, create, update: if isAuthenticated() || isAdmin();
      allow delete: if isAdmin();
    }

    // 5. Trip & Safari Inquiries
    match /inquiries/{inquiryId} {
      // Anyone can submit a trip inquiry
      allow create: if request.resource.data.customerEmail is string;
      // Inquiries can be read by their creator (by UID or email) or by admins
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.customerId == request.auth.uid || 
          resource.data.customerEmail == request.auth.token.email
        )
      );
      // Only admins can update status, add quotes, or delete
      allow update, delete: if isAdmin();
    }

    // 6. Tour & Accommodation Bookings
    match /bookings/{bookingId} {
      allow create: if request.resource.data.customerEmail is string;
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.customerId == request.auth.uid || 
          resource.data.customerEmail == request.auth.token.email
        )
      );
      allow update, delete: if isAdmin();
    }

    // 7. Verified Customer Reviews & Moderation
    match /reviews/{reviewId} {
      // Public can read approved reviews
      allow read: if resource.data.status == 'approved' || isAdmin();
      // Anyone can submit a review with pending status
      allow create: if request.resource.data.rating is number;
      // Only admins can moderate (approve/reject)
      allow update, delete: if isAdmin();
    }

    // 8. Public Travel Gallery Stories
    match /gallery_stories/{storyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Marketing Subscribers & Campaigns
    match /subscribers/{subscriberId} {
      allow create, update: if request.resource.data.email is string;
      allow read, delete: if isAdmin();
    }

    match /campaigns/{campaignId} {
      allow read, write: if isAdmin();
    }

    // 10. CMS Managed Content (Packages, Destinations, Gallery)
    match /cms_packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms_destinations/{destinationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms_gallery/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10B. CMS Transport Operators & Regional Routes
    match /cms_transport_operators/{operatorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms_transport_routes/{routeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /transport_inquiries/{inquiryId} {
      allow create: if request.resource.data.customerEmail is string;
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.customerEmail == request.auth.token.email
        )
      );
      allow update, delete: if isAdmin();
    }

    // 11. Legacy Public Content
    match /destinations/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tours/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /packages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stays/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 12. Contact Messages
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }

    // 13. Administrators Ledger
    match /admins/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 14. Website & Business Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /businessSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 15. Automated Email Queue & Audit Logs
    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /notificationLogs/{logId} {
      allow read, delete: if isAdmin();
      allow create: if true;
      allow update: if isAdmin();
    }

    // 16. Visitor Analytics
    match /analyticsDaily/{dayId} {
      allow read: if isAdmin();
      allow write: if true;
    }
  }
}
