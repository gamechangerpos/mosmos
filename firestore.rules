rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is accessing their own customer record
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Check if user has an authorized admin record in Firestore
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 1. Customer Profiles
    match /customers/{userId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Administrators Ledger (Cannot be self-assigned)
    match /admins/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3. Trip & Safari Inquiries
    match /inquiries/{inquiryId} {
      // Anyone can submit a trip inquiry
      allow create: if request.resource.data.customerEmail is string;
      // Inquiries can be read by their creator (by UID or email) or by admins
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.customerId == request.auth.uid || 
          resource.data.customerEmail == request.auth.token.email
        )
      );
      // Only admins can update status, add quotes, or delete
      allow update, delete: if isAdmin();
    }

    // 4. Tour & Accommodation Bookings
    match /bookings/{bookingId} {
      allow create: if request.resource.data.customerEmail is string;
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.customerId == request.auth.uid || 
          resource.data.customerEmail == request.auth.token.email
        )
      );
      allow update, delete: if isAdmin();
    }

    // 5. Contact Messages
    match /contactMessages/{messageId} {
      // Anyone can send a message via contact form
      allow create: if request.resource.data.email is string;
      // Only admins can read or manage customer contact messages
      allow read, update, delete: if isAdmin();
    }

    // 6. Newsletter Subscribers
    match /newsletter/{subscriberId} {
      allow create: if request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }

    // 7. Public Content: Destinations, Tours, Packages, Stays, Testimonials
    match /destinations/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tours/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /packages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stays/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Website Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
